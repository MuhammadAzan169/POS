# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Supabase
# Dashboard -> Project Settings -> API Keys
#
# Both are VITE_-prefixed, so they are bundled into the browser JavaScript and
# are PUBLIC. That is fine for these two: the anon key is meant to be published
# and access is controlled by Row Level Security.
#
# Leave them blank to run the app on its built-in demo data.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# OpenRouter (AI Assistant — added in the next stage)
#
# NO VITE_ PREFIX ON PURPOSE. This key must never reach the browser; it is read
# only by server functions. Anyone who obtained it could spend your credits.
#
# Key:   https://openrouter.ai/keys
# Model: https://openrouter.ai/models  (filter "Free", ids end in `:free`)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL1=
OPENROUTER_MODEL2=
OPENROUTER_MODEL3=
OPENROUTER_APP_URL=http://localhost:8080
OPENROUTER_APP_NAME=A-POS

.venv/
venv/
env/
ENV/
.python-version

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test / coverage / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

